@model ReportAutomationApp.Models.Client

<h2>Add Client</h2>

<form asp-action="AddClient" method="post">

    <div>
        <label>Client Name</label>
        <input asp-for="ClientName" class="form-control" />
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Save Client
    </button>

</form>